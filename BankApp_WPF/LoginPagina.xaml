<Window x:Class="BankApp_WPF.LoginPagina"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AccessBank - Login"
        Height="900"
        Width="1600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#000000"
        >

    <Window.Resources>
        <!-- Formulierlabel (boven elk invoerveld) -->
        <Style x:Key="LoginFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Invoerveld (TextBox, PasswordBox) -->
        <Style x:Key="LoginInputField" TargetType="Control">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Actieknop (kleur wordt per knop lokaal overschreven) -->
        <Style x:Key="LoginActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="400">

            <!-- Titel -->
            <TextBlock Text="Inloggen bij AccessBank"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,40"
                       HorizontalAlignment="Center"/>

            <!-- E-mail -->
            <TextBlock Text="E-mail:" Style="{StaticResource LoginFieldLabel}"/>
            <TextBox x:Name="TxtEmail"
                     Style="{StaticResource LoginInputField}"/>

            <!-- Wachtwoord -->
            <TextBlock Text="Wachtwoord:" Style="{StaticResource LoginFieldLabel}"/>
            <PasswordBox x:Name="TxtPassword"
                         Style="{StaticResource LoginInputField}"
                         KeyDown="TxtPassword_KeyDown"/>

            <!-- Foutmelding -->
            <TextBlock x:Name="TxtError"
                       Foreground="Red"
                       Visibility="Collapsed"
                       FontSize="14"
                       Margin="0,0,0,15"/>

            <!-- Knoppen -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="BtnLogin"
                        Content="Inloggen"
                        Width="120"
                        Style="{StaticResource LoginActionButton}"
                        Background="#10B981"
                        Click="BtnLogin_Click"/>

                <Button x:Name="BtnBack"
                        Content="Terug"
                        Width="100"
                        Style="{StaticResource LoginActionButton}"
                        Background="#1E88E5"
                        Click="BtnBack_Click"/>

                <Button x:Name="BtnTheme"
                        Content="☀"
                        Width="60"
                        FontSize="20"
                        Style="{StaticResource LoginActionButton}"
                        Background="#FDB022"
                        Margin="0"
                        Click="BtnTheme_Click"/>
            </StackPanel>

            <!-- Wachtwoord vergeten -->
            <TextBlock Text="Wachtwoord vergeten?"
                       Foreground="LightBlue"
                       FontSize="14"
                       Margin="0,25,0,0"
                       HorizontalAlignment="Center"
                       Cursor="Hand"
                       MouseLeftButtonDown="LinkForgotPassword_Click"/>

        </StackPanel>
    </Grid>
</Window>
