<Window x:Class="BankApp_WPF.RegistratiePagina"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AccessBank - Registreren"
        Height="900"
        Width="1600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#000000"
        KeyDown="Window_KeyDown">

    <Window.Resources>
        <!-- Formulierlabel (boven elk invoerveld) -->
        <Style x:Key="FormFieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Invoerveld (TextBox, PasswordBox, DatePicker) -->
        <Style x:Key="FormInputField" TargetType="Control">
            <Setter Property="Height" Value="60"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Background" Value="#1F2937"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#4B5563"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>

        <!-- Terug-knop in de header -->
        <Style x:Key="HeaderBackButton" TargetType="Button">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Width" Value="180"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="White"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Primaire actie-knop (Account Aanmaken) -->
        <Style x:Key="PrimaryFormButton" TargetType="Button">
            <Setter Property="Height" Value="80"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#9333EA"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#A855F7"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

	<Grid Margin="30">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- HEADER -->
		<Grid Grid.Row="0" Margin="0,0,0,30">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<Button x:Name="BackButton"
                    Grid.Column="0"
                    Style="{StaticResource HeaderBackButton}"
                    Click="BackButton_Click">
				<StackPanel Orientation="Horizontal">
					<TextBlock Text="←" FontSize="24" Margin="0,0,10,0"/>
					<TextBlock Text="Terug" VerticalAlignment="Center"/>
				</StackPanel>
			</Button>

			<TextBlock Grid.Column="1"
                       Text="Registreren"
                       FontSize="36"
                       FontWeight="Bold"
                       Foreground="White"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
		</Grid>

		<!-- SCROLLABLE CONTENT -->
		<ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PanningMode="VerticalOnly">
			<StackPanel>

				<!-- REGISTRATIE CARD -->
				<Border Background="#1C1C1C"
                        BorderBrush="#374151"
                        BorderThickness="4"
                        CornerRadius="12"
                        Padding="40"
                        Margin="0,0,0,30">
					<StackPanel>
						<StackPanel Orientation="Horizontal" Margin="0,0,0,30">
							<Border Background="#9333EA"
                                    Width="50"
                                    Height="50"
                                    CornerRadius="25"
                                    Margin="0,0,15,0">
								<TextBlock Text="📝"
                                         FontSize="28"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
							<TextBlock Text="Account Aanmaken"
                                     FontSize="32"
                                     FontWeight="Bold"
                                     Foreground="White"
                                     VerticalAlignment="Center"/>
						</StackPanel>

						<!-- Voornaam -->
						<TextBlock Text="Voornaam *" Style="{StaticResource FormFieldLabel}"/>
						<TextBox x:Name="VoornaamBox" Style="{StaticResource FormInputField}"/>

						<!-- Achternaam -->
						<TextBlock Text="Achternaam *" Style="{StaticResource FormFieldLabel}"/>
						<TextBox x:Name="AchternaamBox" Style="{StaticResource FormInputField}"/>

						<!-- Email -->
						<TextBlock Text="Email *" Style="{StaticResource FormFieldLabel}"/>
						<TextBox x:Name="EmailBox" Style="{StaticResource FormInputField}"/>

						<!-- Wachtwoord -->
						<TextBlock Text="Wachtwoord *" Style="{StaticResource FormFieldLabel}"/>
						<PasswordBox x:Name="WachtwoordBox" Style="{StaticResource FormInputField}"/>

						<!-- Wachtwoord Bevestigen -->
						<TextBlock Text="Wachtwoord Bevestigen *" Style="{StaticResource FormFieldLabel}"/>
						<PasswordBox x:Name="BevestigBox" Style="{StaticResource FormInputField}"/>

						<!-- Telefoonnummer -->
						<TextBlock Text="Telefoonnummer *" Style="{StaticResource FormFieldLabel}"/>
						<TextBox x:Name="TelefoonBox" Style="{StaticResource FormInputField}"/>

						<!-- Geboortedatum -->
						<TextBlock Text="Geboortedatum *" Style="{StaticResource FormFieldLabel}"/>
                        <DatePicker x:Name="GeboortePicker" Style="{StaticResource FormInputField}">
                            <DatePicker.Resources>
                                <Style TargetType="DatePickerTextBox">
                                    <Setter Property="Foreground" Value="White"/>
                                    <Setter Property="Background" Value="#1F2937"/>
                                    <Setter Property="BorderBrush" Value="#4B5563"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="10,0,0,0"/>
                                </Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="White"/>
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>

                        <!-- Adres -->
                        <!-- Straatnaam -->
                        <TextBlock Text="Straatnaam *" Style="{StaticResource FormFieldLabel}"/>
                        <TextBox x:Name="StraatBox" Style="{StaticResource FormInputField}"/>

                        <!-- Huisnummer en Bus -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Huisnummer *" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox x:Name="HuisnrBox" Style="{StaticResource FormInputField}" Margin="0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Bus (optioneel)" Style="{StaticResource FormFieldLabel}"/>
                                <TextBox x:Name="BusBox" Style="{StaticResource FormInputField}" Margin="0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Postcode -->
                        <TextBlock Text="Postcode *" Style="{StaticResource FormFieldLabel}"/>
                        <TextBox x:Name="PostcodeBox" Style="{StaticResource FormInputField}"/>

                        <!-- Gemeente -->
                        <TextBlock Text="Gemeente *" Style="{StaticResource FormFieldLabel}"/>
                        <TextBox x:Name="GemeenteBox" Style="{StaticResource FormInputField}"/>

                        <!-- Land -->
                        <TextBlock Text="Land *" Style="{StaticResource FormFieldLabel}"/>
                        <TextBox x:Name="LandBox" Style="{StaticResource FormInputField}" Margin="0,0,0,30"/>

                        <TextBlock Text="Uw IBAN en kaartnummer worden automatisch toegewezen na succesvolle registratie"
                                   Foreground="#9CA3AF"
                                   FontSize="16"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,30"
                                   HorizontalAlignment="Center"/>

                        <!-- Registreer Knop -->
						<Button x:Name="RegistreerBtn"
                              Style="{StaticResource PrimaryFormButton}"
                              Cursor="Hand"
                              Content="Account Aanmaken"
                                Click="RegistreerBtn_Click"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

		<!-- KEYBOARD HINT -->
		<Border Grid.Row="2"
                Background="#1F2937"
                BorderBrush="#374151"
                BorderThickness="2"
                CornerRadius="8"
                Padding="15"
                Margin="0,20,0,0"
                HorizontalAlignment="Center">
			<StackPanel Orientation="Horizontal">
				<Border Background="#4B5563"
                        CornerRadius="6"
                        Padding="10,5"
                        Margin="0,0,10,0">
					<TextBlock Text="Z"
                             FontSize="16"
                             FontWeight="Bold"
                             Foreground="White"/>
				</Border>
				<TextBlock Text="Druk op 'Z' om terug te gaan"
                         FontSize="16"
                         Foreground="#D1D5DB"
                         VerticalAlignment="Center"/>
			</StackPanel>
		</Border>

    </Grid>
</Window>
