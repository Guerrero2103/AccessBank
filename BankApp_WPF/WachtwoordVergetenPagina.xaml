<Window x:Class="BankApp_WPF.WachtwoordVergetenPagina"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AccessBank - Wachtwoord Vergeten"
        Height="900"
        Width="1600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#000000">

    <Window.Resources>
        <!-- Formulierlabel (boven elk invoerveld) -->
        <Style x:Key="LoginFieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Invoerveld (TextBox, PasswordBox) -->
        <Style x:Key="LoginInputField" TargetType="Control">
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="0,5,0,15"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Actieknop (kleur wordt per knop lokaal overschreven) -->
        <Style x:Key="LoginActionButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="450">

            <!-- Titel -->
            <TextBlock Text="Wachtwoord Vergeten"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0,0,0,10"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="Vul je e-mailadres in om een resetcode aan te vragen."
                       Foreground="#999999"
                       FontSize="13"
                       Margin="0,0,0,25"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"/>

            <!-- E-mail -->
            <TextBlock Text="E-mail:" Style="{StaticResource LoginFieldLabel}"/>
            <TextBox x:Name="TxtEmail"
                     Style="{StaticResource LoginInputField}"/>

            <!-- Foutmelding -->
            <TextBlock x:Name="TxtError"
                       Foreground="Red"
                       Visibility="Collapsed"
                       FontSize="14"
                       TextWrapping="Wrap"
                       Margin="0,0,0,15"/>

            <!-- Demo-codeweergave -->
            <Border x:Name="BorderDemoCode"
                    Visibility="Collapsed"
                    Background="#1F2937"
                    BorderBrush="#FDB022"
                    BorderThickness="2"
                    CornerRadius="6"
                    Padding="15"
                    Margin="0,0,0,20">
                <TextBlock x:Name="TxtDemoCode"
                           Foreground="#FDB022"
                           FontSize="14"
                           TextWrapping="Wrap"/>
            </Border>

            <!-- Knoppen -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="BtnVerstuur"
                        Content="Verstuur reset-aanvraag"
                        Width="220"
                        Style="{StaticResource LoginActionButton}"
                        Background="#10B981"
                        Click="BtnVerstuur_Click"/>

                <Button x:Name="BtnVolgende"
                        Content="Volgende →"
                        Width="140"
                        Visibility="Collapsed"
                        Style="{StaticResource LoginActionButton}"
                        Background="#1E88E5"
                        Click="BtnVolgende_Click"/>

                <Button x:Name="BtnTerug"
                        Content="Terug"
                        Width="100"
                        Style="{StaticResource LoginActionButton}"
                        Background="#6b7280"
                        Margin="0"
                        Click="BtnTerug_Click"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
