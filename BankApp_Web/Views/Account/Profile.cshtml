@model BankApp_Web.Models.ProfileViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using BankApp_Web.Translations
@inject IStringLocalizer<SharedResource> _localizer

@{
    ViewData["Title"] = _localizer["Profiel Raadplegen"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .profile-container {
        background-color: #000000;
        min-height: calc(100vh - 200px);
        padding: 30px 20px;
    }

    .profile-header {
        display: flex;
        align-items: center;
        margin-bottom: 30px;
    }

    .btn-back-header {
        height: 60px;
        width: 180px;
        font-size: 20px;
        font-weight: bold;
        background-color: #FFFFFF;
        color: #000000;
        border: 4px solid #FFFFFF;
        border-radius: 8px;
        cursor: pointer;
        text-decoration: none;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 20px;
    }

    .btn-back-header:hover {
        background-color: #F0F0F0;
    }

    .profile-title {
        font-size: 36px;
        font-weight: bold;
        color: #FFFFFF;
        flex: 1;
        text-align: center;
    }

    .profile-card {
        background-color: #1C1C1C;
        border: 4px solid #374151;
        border-radius: 12px;
        padding: 40px;
        max-width: 800px;
        margin: 0 auto 30px auto;
    }

    .card-header-section {
        display: flex;
        align-items: center;
        margin-bottom: 30px;
    }

    .card-icon {
        background-color: #9333EA;
        width: 50px;
        height: 50px;
        border-radius: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-right: 15px;
    }

    .card-title {
        font-size: 32px;
        font-weight: bold;
        color: #FFFFFF;
    }

    .form-label {
        color: #FFFFFF;
        font-size: 20px;
        font-weight: 600;
        margin-bottom: 8px;
    }

    .form-control {
        background-color: #1F2937;
        border: 4px solid #4B5563;
        color: #FFFFFF;
        height: 60px;
        font-size: 18px;
        padding: 0 15px;
        margin-bottom: 20px;
    }

    .form-control:focus {
        background-color: #1F2937;
        border-color: #9333EA;
        color: #FFFFFF;
        box-shadow: 0 0 0 0.2rem rgba(147, 51, 234, 0.25);
    }

    .form-control:disabled,
    .form-control[readonly] {
        background-color: #374151;
        color: #9CA3AF;
        cursor: not-allowed;
    }

    .row-fields {
        display: grid;
        grid-template-columns: 1fr 20px 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .btn-save {
        height: 80px;
        font-size: 24px;
        font-weight: bold;
        background-color: #9333EA;
        color: #FFFFFF;
        border: 4px solid #A855F7;
        border-radius: 8px;
        cursor: pointer;
        width: 100%;
    }

    .btn-save:hover {
        background-color: #A855F7;
    }

    .text-danger {
        color: #FF0000;
        font-size: 14px;
    }

    .delete-card {
        background-color: #450A0A;
        border: 4px solid #991B1B;
        border-radius: 12px;
        padding: 40px;
        max-width: 800px;
        margin: 0 auto;
    }

    .delete-icon {
        background-color: #DC2626;
        width: 50px;
        height: 50px;
        border-radius: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin-right: 15px;
    }

    .warning-box {
        background-color: #7F1D1D;
        border: 2px solid #991B1B;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 25px;
    }

    .warning-text {
        color: #FECACA;
        font-size: 18px;
        line-height: 28px;
    }

    .btn-delete {
        height: 80px;
        font-size: 24px;
        font-weight: bold;
        background-color: #DC2626;
        color: #FFFFFF;
        border: 4px solid #F87171;
        border-radius: 8px;
        cursor: pointer;
        width: 100%;
    }

    .alert-success {
        background-color: #10B981;
        color: white;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
    }
</style>

<div class="profile-container">
    <div class="profile-header">
        <a asp-controller="Home" asp-action="Index" class="btn-back-header">
            <span style="font-size: 24px; margin-right: 10px;">←</span>
            <span>@_localizer["Terug"]</span>
        </a>
        <h1 class="profile-title">@_localizer["Profiel Raadplegen"]</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success" style="max-width: 800px; margin: 0 auto 20px auto;">
            @TempData["SuccessMessage"]
        </div>
    }

    <div class="profile-card">
        <div class="card-header-section">
            <div class="card-icon">👤</div>
            <h2 class="card-title">@_localizer["Mijn Gegevens"]</h2>
        </div>

        <form asp-action="Profile" method="post">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label asp-for="Voornaam" class="form-label">@_localizer["Voornaam"] *</label>
                <input asp-for="Voornaam" class="form-control" />
                <span asp-validation-for="Voornaam" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Achternaam" class="form-label">@_localizer["Achternaam"] *</label>
                <input asp-for="Achternaam" class="form-control" />
                <span asp-validation-for="Achternaam" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">@_localizer["Email"]</label>
                <input asp-for="Email" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="NieuweWachtwoord" class="form-label">@_localizer["Nieuwe Wachtwoord"]</label>
                <input asp-for="NieuweWachtwoord" class="form-control" type="password" />
                <small class="text-muted">@_localizer["Laat leeg om wachtwoord niet te wijzigen"]</small>
                <span asp-validation-for="NieuweWachtwoord" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="WachtwoordBevestigen" class="form-label">@_localizer["Wachtwoord Bevestigen"]</label>
                <input asp-for="WachtwoordBevestigen" class="form-control" type="password" />
                <span asp-validation-for="WachtwoordBevestigen" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Telefoonnummer" class="form-label">@_localizer["Telefoonnr."]</label>
                <input asp-for="Telefoonnummer" class="form-control" />
                <span asp-validation-for="Telefoonnummer" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Iban" class="form-label">@_localizer["IBAN"] (@_localizer["Alleen lezen"])</label>
                <input asp-for="Iban" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="Geboortedatum" class="form-label">@_localizer["Geboortedatum"]</label>
                <input asp-for="Geboortedatum" class="form-control" type="date" />
                <span asp-validation-for="Geboortedatum" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Straat" class="form-label">@_localizer["Straatnaam"] *</label>
                <input asp-for="Straat" class="form-control" />
                <span asp-validation-for="Straat" class="text-danger"></span>
            </div>

            <div class="row-fields">
                <div>
                    <label asp-for="Huisnummer" class="form-label">@_localizer["Huisnummer"] *</label>
                    <input asp-for="Huisnummer" class="form-control" />
                    <span asp-validation-for="Huisnummer" class="text-danger"></span>
                </div>
                <div></div>
                <div>
                    <label asp-for="Bus" class="form-label">@_localizer["Bus (optioneel)"]</label>
                    <input asp-for="Bus" class="form-control" />
                    <span asp-validation-for="Bus" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Postcode" class="form-label">@_localizer["Postcode"] *</label>
                <input asp-for="Postcode" class="form-control" />
                <span asp-validation-for="Postcode" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Gemeente" class="form-label">@_localizer["Gemeente"] *</label>
                <input asp-for="Gemeente" class="form-control" />
                <span asp-validation-for="Gemeente" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Land" class="form-label">@_localizer["Land"] *</label>
                <input asp-for="Land" class="form-control" />
                <span asp-validation-for="Land" class="text-danger"></span>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="text-danger mb-3">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <button type="submit" class="btn btn-save">@_localizer["Wijzigingen Opslaan"]</button>
        </form>
    </div>

    <div class="delete-card">
        <div class="card-header-section">
            <div class="delete-icon">🗑️</div>
            <h2 class="card-title">@_localizer["Profiel Verwijderen"]</h2>
        </div>

        <div class="warning-box">
            <div style="font-size: 18px; font-weight: bold; color: #FEE2E2; margin-bottom: 10px;">⚠️ @_localizer["LET OP"]</div>
            <div class="warning-text">
                @_localizer["Deze actie kan niet ongedaan gemaakt worden. Al uw gegevens worden permanent verwijderd."]
            </div>
        </div>

        <form asp-action="DeleteProfile" method="post" onsubmit="return confirm('@_localizer["Weet u zeker dat u uw profiel wilt verwijderen? Deze actie kan niet ongedaan gemaakt worden."]');">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-delete">
                <span style="font-size: 28px; margin-right: 15px;">🗑️</span>
                <span>@_localizer["Profiel Verwijderen"]</span>
            </button>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        document.addEventListener('keydown', function(e) {
            if (e.key === 'z' || e.key === 'Z') {
                window.location.href = '@Url.Action("Index", "Home")';
            }
        });
    </script>
}
