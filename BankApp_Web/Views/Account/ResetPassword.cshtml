@model BankApp_Web.Models.ResetPasswordViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using BankApp_Web.Translations
@inject IStringLocalizer<SharedResource> _localizer

@{
    ViewData["Title"] = _localizer["Nieuw Wachtwoord Instellen"];
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .login-container {
        min-height: calc(100vh - 200px);
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #000000;
        padding: 40px 20px;
    }

    .login-card {
        background-color: #1C1C1C;
        border: 4px solid #374151;
        border-radius: 12px;
        padding: 40px;
        width: 100%;
        max-width: 420px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
    }

    .login-title {
        font-size: 28px;
        font-weight: bold;
        color: #FFFFFF;
        text-align: center;
        margin-bottom: 25px;
    }

    .form-label {
        color: #FFFFFF;
        font-size: 16px;
        margin-bottom: 8px;
    }

    .form-control {
        background-color: #1F2937;
        border: 4px solid #4B5563;
        color: #FFFFFF;
        height: 35px;
        font-size: 16px;
        padding: 0 15px;
        margin-bottom: 15px;
    }

    .form-control:focus {
        background-color: #1F2937;
        border-color: #10B981;
        color: #FFFFFF;
        box-shadow: 0 0 0 0.2rem rgba(16, 185, 129, 0.25);
    }

    .btn-login {
        background-color: #10B981;
        color: #FFFFFF;
        border: none;
        width: 220px;
        height: 40px;
        font-size: 16px;
        font-weight: bold;
        margin-right: 10px;
    }

    .btn-back {
        background-color: #6b7280;
        color: #FFFFFF;
        border: none;
        width: 100px;
        height: 40px;
        font-size: 16px;
        font-weight: bold;
    }

    .btn-group {
        display: flex;
        justify-content: center;
        margin-top: 10px;
    }

    .text-danger {
        color: #FF0000;
        font-size: 14px;
        margin-bottom: 15px;
    }

    .demo-code-box {
        background-color: #1F2937;
        border: 2px solid #FDB022;
        border-radius: 6px;
        padding: 15px;
        color: #FDB022;
        font-size: 14px;
        margin-bottom: 20px;
    }
</style>

<div class="login-container">
    <div class="login-card">
        <h1 class="login-title">@_localizer["Nieuw Wachtwoord Instellen"]</h1>

        @if (ViewBag.DemoCode != null)
        {
            <div class="demo-code-box">@ViewBag.DemoCode</div>
        }

        <form asp-action="ResetPassword" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="Email" type="hidden" />

            <div class="mb-3">
                <label class="form-label">@_localizer["E-mail:"]</label>
                <input class="form-control" value="@Model.Email" disabled />
            </div>

            <div class="mb-3">
                <label asp-for="Code" class="form-label">@_localizer["Resetcode:"]</label>
                <input asp-for="Code" class="form-control" maxlength="6" autofocus />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="NieuweWachtwoord" class="form-label">@_localizer["Nieuw wachtwoord:"]</label>
                <input asp-for="NieuweWachtwoord" class="form-control" type="password" />
                <span asp-validation-for="NieuweWachtwoord" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="WachtwoordBevestigen" class="form-label">@_localizer["Bevestig nieuw wachtwoord:"]</label>
                <input asp-for="WachtwoordBevestigen" class="form-control" type="password" />
                <span asp-validation-for="WachtwoordBevestigen" class="text-danger"></span>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="text-danger">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <div class="btn-group">
                <button type="submit" class="btn btn-login">@_localizer["Wachtwoord Wijzigen"]</button>
                <a asp-action="Login" class="btn btn-back">@_localizer["Terug"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
