@model ErrorViewModel
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using BankApp_Web.Translations
@inject IStringLocalizer<SharedResource> _localizer

@{
    ViewData["Title"] = @_localizer["Fout"];
}

<h1 class="text-danger">@_localizer["Fout"].</h1>
<h2 class="text-danger">@_localizer["Er is een fout opgetreden"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>Request ID:</strong> <code>@Model.RequestId</code>
    </p>
}
