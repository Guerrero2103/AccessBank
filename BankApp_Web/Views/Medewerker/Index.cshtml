@model IEnumerable<BankApp_Models.Transactie>
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using BankApp_Web.Translations
@inject IStringLocalizer<SharedResource> _localizer

@{
    ViewData["Title"] = @_localizer["Wachtende Transacties"];
}

<h1>@_localizer["Wachtende Transacties"]</h1>

<div class="mb-3">
    <a asp-action="Berichten" class="btn btn-primary">@_localizer["Klantenberichten"]</a>
</div>

<!-- Zoekbalk -->
<div class="row mb-3">
    <div class="col-md-6">
        <form asp-action="Index" method="get">
            <div class="input-group">
                <input type="text" name="searchString" class="form-control" placeholder="@_localizer["Zoeken op IBAN of gebruiker..."]" value="@ViewData["CurrentFilter"]" />
                <input type="hidden" name="sortOrder" value="@ViewData["CurrentSort"]" />
                <button class="btn btn-outline-secondary" type="submit">@_localizer["Zoeken"]</button>
                @if (!string.IsNullOrEmpty(ViewData["CurrentFilter"]?.ToString()))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary">@_localizer["Wissen"]</a>
                }
            </div>
        </form>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["DatumSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" style="text-decoration: none; color: inherit;">
                    @_localizer["Datum"]
                    @if (ViewData["DatumSortParm"]?.ToString() == "datum_desc")
                    {
                        <span>▼</span>
                    }
                    else if (string.IsNullOrEmpty(ViewData["CurrentSort"]?.ToString()))
                    {
                        <span>▼</span>
                    }
                    else
                    {
                        <span>▲</span>
                    }
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["VanIbanSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" style="text-decoration: none; color: inherit;">
                    @_localizer["Van IBAN"]
                    @if (ViewData["VanIbanSortParm"]?.ToString() == "vaniban_desc")
                    {
                        <span>▼</span>
                    }
                    else if (ViewData["VanIbanSortParm"]?.ToString() == "VanIban")
                    {
                        <span>▲</span>
                    }
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["NaarIbanSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" style="text-decoration: none; color: inherit;">
                    @_localizer["Naar IBAN"]
                    @if (ViewData["NaarIbanSortParm"]?.ToString() == "naariban_desc")
                    {
                        <span>▼</span>
                    }
                    else if (ViewData["NaarIbanSortParm"]?.ToString() == "NaarIban")
                    {
                        <span>▲</span>
                    }
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["BedragSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" style="text-decoration: none; color: inherit;">
                    @_localizer["Bedrag"]
                    @if (ViewData["BedragSortParm"]?.ToString() == "bedrag_desc")
                    {
                        <span>▼</span>
                    }
                    else if (ViewData["BedragSortParm"]?.ToString() == "Bedrag")
                    {
                        <span>▲</span>
                    }
                </a>
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["GebruikerSortParm"]" asp-route-searchString="@ViewData["CurrentFilter"]" style="text-decoration: none; color: inherit;">
                    @_localizer["Gebruiker"]
                    @if (ViewData["GebruikerSortParm"]?.ToString() == "gebruiker_desc")
                    {
                        <span>▼</span>
                    }
                    else if (ViewData["GebruikerSortParm"]?.ToString() == "Gebruiker")
                    {
                        <span>▲</span>
                    }
                </a>
            </th>
            <th>@_localizer["Acties"]</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.Datum)</td>
                <td>@Html.DisplayFor(modelItem => item.VanIban)</td>
                <td>@Html.DisplayFor(modelItem => item.NaarIban)</td>
                <td>€@Html.DisplayFor(modelItem => item.Bedrag)</td>
                <td>@Html.DisplayFor(modelItem => item.Gebruiker.Email)</td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">@_localizer["Details"]</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-white">@_localizer["Geen wachtende transacties"]</p>
}
