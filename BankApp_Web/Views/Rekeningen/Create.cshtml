@model BankApp_Models.Rekening
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using BankApp_Web.Translations
@inject IStringLocalizer<SharedResource> _localizer

@{
    ViewData["Title"] = @_localizer["Nieuwe Rekening"];
}

<h1>@_localizer["Nieuwe Rekening"]</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Iban" class="control-label">@_localizer["IBAN"]</label>
                <input asp-for="Iban" class="form-control" value="@ViewBag.GeneratedIban" readonly />
                <small class="form-text text-white">@_localizer["IBAN wordt automatisch gegenereerd"]</small>
                <span asp-validation-for="Iban" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Saldo" class="control-label">@_localizer["Saldo"]</label>
                <input asp-for="Saldo" class="form-control" type="number" step="0.01" value="0.00" readonly />
                <span asp-validation-for="Saldo" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="GebruikerId" />
            <div class="form-group mt-3">
                <input type="submit" value="@_localizer["Aanmaken"]" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">@_localizer["Annuleren"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
