@model BankApp_Models.Rekening
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using BankApp_Web.Translations
@inject IStringLocalizer<SharedResource> _localizer

@{
    ViewData["Title"] = @_localizer["Rekening Details"];
}

<h1>@_localizer["Rekening Details"]</h1>

<div>
    <h4>@_localizer["Rekening"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @_localizer["IBAN"]
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Iban)
        </dd>
        <dt class="col-sm-2">
            @_localizer["Saldo"]
        </dt>
        <dd class="col-sm-10">
            €@Html.DisplayFor(model => model.Saldo)
        </dd>
        <dt class="col-sm-2">
            @_localizer["Gebruiker"]
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Gebruiker.Email)
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Index" class="btn btn-secondary">@_localizer["Terug naar overzicht"]</a>
</div>
