@using BankApp_Models
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.Localization
@using Microsoft.AspNetCore.Mvc.Localization

@inject SignInManager<BankUser> SignInManager
@inject UserManager<BankUser> UserManager
@using Microsoft.Extensions.Localization
@using BankApp_Web.Translations
@inject IStringLocalizer<SharedResource> _localizer

<ul class="navbar-nav">
@if (SignInManager.IsSignedIn(User))
{
    <li class="nav-item">
        <a id="manage" class="nav-link text-dark" asp-controller="Account" asp-action="Profile" title="Profiel">@_localizer["Hallo"] @UserManager.GetUserName(User)!</a>
    </li>
    <li class="nav-item">
        <form id="logoutForm" class="form-inline" asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button id="logout" type="submit" class="nav-link btn btn-link text-dark border-0">@_localizer["Uitloggen"]</button>
        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link text-dark" id="register" asp-controller="Account" asp-action="Register">@_localizer["Registreren"]</a>
    </li>
    <li class="nav-item">
        <a class="nav-link text-dark" id="login" asp-controller="Account" asp-action="Login">@_localizer["Inloggen"]</a>
    </li>
}
</ul>

