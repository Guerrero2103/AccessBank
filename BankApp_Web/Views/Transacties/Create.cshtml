@model BankApp_Models.Transactie
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using BankApp_Web.Translations
@inject IStringLocalizer<SharedResource> _localizer
@inject IStringLocalizer<SharedResource> _stringLocalizer

@{
    ViewData["Title"] = @_localizer["Nieuwe Overschrijving"];
}

<h1>@_localizer["Nieuwe Overschrijving"]</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="VanIban" class="control-label">@_localizer["Van IBAN"]</label>
                @{
                    var ibanLijst = ViewBag.VanIbanLijst as List<string> ?? new List<string>();
                    var selectText = _stringLocalizer["Selecteer rekening"].Value;
                }
                <select name="VanIban" id="VanIban" class="form-control">
                    <option value="">@selectText</option>
                    @if (ibanLijst != null && ibanLijst.Any())
                    {
                        @foreach (var iban in ibanLijst)
                        {
                            <option value="@iban">@iban</option>
                        }
                    }
                </select>
                <span asp-validation-for="VanIban" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NaarIban" class="control-label">@_localizer["Naar IBAN"]</label>
                <input asp-for="NaarIban" class="form-control" />
                <span asp-validation-for="NaarIban" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="NaamOntvanger" class="control-label">@_localizer["Naam Ontvanger"]</label>
                <input asp-for="NaamOntvanger" class="form-control" />
                <span asp-validation-for="NaamOntvanger" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Bedrag" class="control-label">@_localizer["Bedrag"]</label>
                <input asp-for="Bedrag" class="form-control" type="number" step="0.01" min="0.01" />
                <span asp-validation-for="Bedrag" class="text-danger"></span>
                <small class="form-text text-white">@_localizer["Bedragen vanaf 500 vereisen medewerker bevestiging"]</small>
            </div>
            <div class="form-group">
                <label asp-for="Omschrijving" class="control-label">@_localizer["Omschrijving"]</label>
                <input asp-for="Omschrijving" class="form-control" />
                <span asp-validation-for="Omschrijving" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="@_localizer["Verzenden"]" class="btn btn-primary" />
                <a asp-action="Index" class="btn btn-secondary">@_localizer["Annuleren"]</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
