@model BankApp_Models.Transactie
@using Microsoft.AspNetCore.Mvc.Localization
@using Microsoft.Extensions.Localization
@using BankApp_Web.Translations
@inject IStringLocalizer<SharedResource> _localizer

@{
    ViewData["Title"] = @_localizer["Transactie Details"];
}

<h1>@_localizer["Transactie Details"]</h1>

<div>
    <h4>@_localizer["Transactie"]</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @_localizer["Van IBAN"]
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.VanIban)
        </dd>
        <dt class="col-sm-2">
            @_localizer["Naar IBAN"]
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NaarIban)
        </dd>
        <dt class="col-sm-2">
            @_localizer["Naam Ontvanger"]
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.NaamOntvanger)
        </dd>
        <dt class="col-sm-2">
            @_localizer["Bedrag"]
        </dt>
        <dd class="col-sm-10">
            €@Html.DisplayFor(model => model.Bedrag)
        </dd>
        <dt class="col-sm-2">
            @_localizer["Omschrijving"]
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Omschrijving)
        </dd>
        <dt class="col-sm-2">
            @_localizer["Datum"]
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Datum)
        </dd>
        <dt class="col-sm-2">
            @_localizer["Status"]
        </dt>
        <dd class="col-sm-10">
            @if (Model.Status == TransactieStatus.Voltooid)
            {
                <span class="badge bg-success">@_localizer["Voltooid"]</span>
            }
            else if (Model.Status == TransactieStatus.Wachtend)
            {
                <span class="badge bg-warning">@_localizer["Wachtend"]</span>
            }
            else
            {
                <span class="badge bg-danger">@_localizer["Afgewezen"]</span>
            }
        </dd>
        @if (!string.IsNullOrEmpty(Model.AfwijzingsReden))
        {
            <dt class="col-sm-2">
                @_localizer["Afwijzings Reden"]
            </dt>
            <dd class="col-sm-10">
                @Html.DisplayFor(model => model.AfwijzingsReden)
            </dd>
        }
    </dl>
</div>
<div>
    <a asp-action="Index" class="btn btn-secondary">@_localizer["Terug naar overzicht"]</a>
</div>
